layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% assign pages = site.pages | where_exp: "p", "p.noindex != true" %}
{% for p in pages %}
{% if p.url and p.url != '/404.html' and p.url != '/sitemap.xml' and p.url != '/robots.txt' %}
  <url><loc>{{ site.url }}{{ site.baseurl }}{{ p.url }}</loc></url>
{% endif %}
{% endfor %}
</urlset>
